# Copy these into Vercel → Settings → Environment Variables.
# Never commit real values — this file is a template only.

# GoHighLevel Private Integration Token.
# Create at: GHL → Settings → Private Integrations → Create new integration
# Required scope: contacts.write  (contacts.readonly is also useful)
GHL_API_TOKEN=

# The GHL sub-account (location) this website feeds.
# Find at: GHL → Settings → Business Profile → Location ID
GHL_LOCATION_ID=
